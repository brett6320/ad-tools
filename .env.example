# Copy to .env and edit. Keyword arguments and CLI flags override these values, and variables
# already set in the environment override the .env file. Lookup order for the file: --env-file /
# AD_ENV_FILE, then the nearest .env in the current directory or a parent, then the repository root.

# Domain controllers, tried in order. Use names that match the DC certificates (not IP addresses).
# Leave AD_SERVER unset to find the DCs through DNS from AD_DOMAIN (SRV _ldap._tcp.dc._msdcs.<domain>).
# AD_SERVER=dc1.corp.example.com,dc2.corp.example.com
AD_DOMAIN=corp.example.com
# AD_SITE=HQ                    # with DNS discovery: try this AD site's DCs first
# AD_DNS_SERVER=10.0.0.10       # with DNS discovery: query these name servers instead of the system's
# AD_BASE_DN=OU=Corp,DC=corp,DC=example,DC=com   # default: derived from AD_DOMAIN

# ldaps = implicit TLS (636, or 3269 with the global catalog); starttls = upgrade on 389 (or 3268)
AD_TLS_MODE=ldaps
# AD_PORT=636
# AD_GLOBAL_CATALOG=false

# Account to bind as. Pick ONE of the two options below (the password is never stored: you are
# always prompted for it, and AD_PASSWORD is rejected). Leave both unset for an anonymous bind
# (on AD that can only read the rootDSE).
#
# Option 1 - a specific account: UPN, DOMAIN\user or a DN.
AD_BIND_USER=svc-ldap-ro@corp.example.com
#
# Option 2 - your own login: set the NetBIOS domain prefix and leave AD_BIND_USER unset. You bind as
# DOMAIN\<your POSIX user name> (from $LOGNAME/$USER, or %USERNAME% on Windows), e.g. CORP\jdoe.
# If AD_BIND_USER is a bare name (no \, @ or =), the prefix is added to it instead.
# AD_BIND_DOMAIN=CORP

# Certificate trust: auto | truststore | system | bundle
#   auto       - bundle if AD_CA_FILE/AD_CA_PATH is set, else truststore if installed, else system
#   truststore - OS-native verification (macOS Keychain, Windows CryptoAPI, Linux OpenSSL paths)
#   system     - stdlib only: Windows cert stores, Linux distro bundle, macOS system keychains
#   bundle     - only the PEM bundle below (e.g. your AD CS root and issuing CAs)
AD_TRUST=auto
# AD_CA_FILE=/path/to/corp-root-ca.pem
# AD_CA_PATH=/path/to/hashed/ca/dir
# AD_CLIENT_CERT=/path/to/client.pem   # optional mutual TLS
# AD_CLIENT_KEY=/path/to/client.key

# AD_TIMEOUT=10
# AD_PAGE_SIZE=500
# AD_REPORTS_DIR=reports
# AD_DEBUG=true   # protocol trace (LDAP, DNS, TLS certificate) and tracebacks; the password is never logged
